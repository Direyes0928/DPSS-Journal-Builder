{
  "id": "CW_Incoming_ICT_Processed",
  "name": "CalWORKs \u2013 Incoming ICT Processed",
  "file": "CW_Incoming_ICT_Processed.json",
  "program": "CalWORKs",
  "version": "2025-12-02T00:00:00Z",
  "imported": false,
  "sections": [
    {
      "id": "section_1",
      "title": "SHORT DESCRIPTION",
      "fields": [
        {
          "id": "shortDescription",
          "label": "Short Description",
          "type": "textarea"
        }
      ]
    },
    {
      "id": "section_2",
      "title": "LONG DESCRIPTION",
      "fields": [
        {
          "id": "longDescription",
          "label": "Long Description",
          "type": "textarea"
        }
      ]
    },
    {
      "id": "section_3",
      "title": "ICT DETAILS",
      "fields": [
        {
          "id": "ictType",
          "label": "ICT Type",
          "type": "choice",
          "choices": [
            "Incoming ICT \u2013 Approved",
            "Incoming ICT \u2013 Denied",
            "Incoming ICT \u2013 Pending",
            "Incoming ICT \u2013 Incomplete",
            "Incoming ICT \u2013 Other"
          ]
        },
        {
          "id": "ictReceivedDate",
          "label": "ICT Packet Received Date",
          "type": "date"
        },
        {
          "id": "cwEligibility",
          "label": "CalWORKs Eligibility Result",
          "type": "choice",
          "choices": [
            "Eligible",
            "Ineligible",
            "Pending Verification",
            "Insufficient Information"
          ]
        },
        {
          "id": "cfEligibility",
          "label": "CalFresh Eligibility Result",
          "type": "choice",
          "choices": [
            "Eligible",
            "Ineligible",
            "Pending Verification",
            "Insufficient Information"
          ]
        },
        {
          "id": "mcEligibility",
          "label": "Medi-Cal Eligibility Result",
          "type": "choice",
          "choices": [
            "Eligible",
            "Ineligible",
            "Pending Verification",
            "Insufficient Information"
          ]
        }
      ]
    },
    {
      "id": "section_4",
      "title": "HOUSEHOLD COMPOSITION (Copied From ICT Packet)",
      "fields": [
        {
          "id": "hhComposition",
          "label": "Household Members",
          "type": "repeatable",
          "numbered": true,
          "fields": [
            {
              "id": "name",
              "label": "Name",
              "type": "text"
            },
            {
              "id": "ageDob",
              "label": "Age / DOB",
              "type": "text"
            },
            {
              "id": "relationship",
              "label": "Relationship",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "id": "section_5",
      "title": "VERIFICATIONS RECEIVED",
      "fields": [
        {
          "id": "verifications",
          "label": "Verification Items",
          "type": "repeatable",
          "numbered": true,
          "fields": [
            {
              "id": "item",
              "label": "Item",
              "type": "text"
            },
            {
              "id": "status",
              "label": "Status",
              "type": "choice",
              "choices": [
                "Provided",
                "Not Provided",
                "Insufficient",
                "Pending"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "section_6",
      "title": "INCOME & BENEFIT INFORMATION PROVIDED BY SENDING COUNTY",
      "fields": [
        {
          "id": "incomeList",
          "label": "Income Items",
          "type": "repeatable",
          "numbered": true,
          "fields": [
            {
              "id": "source",
              "label": "Income Source",
              "type": "text"
            },
            {
              "id": "amount",
              "label": "Amount",
              "type": "text"
            },
            {
              "id": "frequency",
              "label": "Frequency",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "id": "section_7",
      "title": "ACTIONS TAKEN",
      "fields": [
        {
          "id": "actionsTaken",
          "label": "Actions Taken",
          "type": "textarea",
          "placeholder": "Example: Case transferred. Eligibility updated. ICT processed."
        }
      ]
    },
    {
      "id": "section_8",
      "title": "NOTICE OF ACTION (NOA)",
      "fields": [
        {
          "id": "noaStatus",
          "label": "NOA Status",
          "type": "choice",
          "choices": [
            "Generated",
            "Pending",
            "Not Required"
          ]
        },
        {
          "id": "noaDate",
          "label": "NOA Date",
          "type": "date"
        }
      ]
    }
  ]
}